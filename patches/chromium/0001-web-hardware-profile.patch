@@ -0,0 +1,34 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_HARDWARE_WEB_HARDWARE_PROFILE_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_HARDWARE_WEB_HARDWARE_PROFILE_H_
+
+#include <optional>
+#include <string_view>
+
+#include "third_party/blink/public/common/common_export.h"
+
+namespace blink {
+
+// Web-visible declarations, independent of the resources used by the browser's
+// scheduler and allocators. One profile applies to the whole browser instance.
+struct BLINK_COMMON_EXPORT WebHardwareProfile {
+  int hardware_concurrency = 8;
+  int device_memory_gb = 8;
+  int cpu_performance = 3;
+};
+
+BLINK_COMMON_EXPORT std::optional<WebHardwareProfile> ParseWebHardwareProfile(
+    std::string_view json);
+
+// INVISIBLE_CHROMIUM_PROFILE is set before launching the browser and inherited
+// by its children, including Linux zygotes. The first read is cached for the
+// process lifetime. An unset variable preserves the upstream data sources.
+BLINK_COMMON_EXPORT const std::optional<WebHardwareProfile>&
+GetWebHardwareProfile();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_HARDWARE_WEB_HARDWARE_PROFILE_H_
