+#include "third_party/blink/public/common/hardware/web_hardware_profile.h"
 
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  if (const auto& profile = GetWebHardwareProfile()) {
+    return static_cast<unsigned>(profile->hardware_concurrency);
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
