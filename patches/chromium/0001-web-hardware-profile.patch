diff --git a/third_party/blink/common/hardware/web_hardware_profile.cc b/third_party/blink/common/hardware/web_hardware_profile.cc
new file mode 100644
index 0000000..58714d5
--- /dev/null
+++ b/third_party/blink/common/hardware/web_hardware_profile.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/hardware/web_hardware_profile.h"
+
+#include "base/check.h"
+#include "base/environment.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+
+namespace blink {
+
+std::optional<WebHardwareProfile> ParseWebHardwareProfile(
+    std::string_view json) {
+  auto dict = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+
+  auto read_int = [&dict](std::string_view key, int& destination) {
+    const base::Value* value = dict->Find(key);
+    if (!value) {
+      return true;
+    }
+    if (!value->is_int()) {
+      return false;
+    }
+    destination = value->GetInt();
+    return true;
+  };
+
+  WebHardwareProfile profile;
+  if (!read_int("hardwareConcurrency", profile.hardware_concurrency) ||
+      !read_int("deviceMemory", profile.device_memory_gb) ||
+      profile.hardware_concurrency < 1) {
+    return std::nullopt;
+  }
+
+  // Start with desktop memory tiers that share the 64-bit V8 heap ceiling.
+  // Smaller tiers also need coordinated isolate resource constraints.
+  if (profile.device_memory_gb != 8 && profile.device_memory_gb != 16 &&
+      profile.device_memory_gb != 32) {
+    return std::nullopt;
+  }
+
+  const int cores = profile.hardware_concurrency;
+  profile.cpu_performance = cores <= 2    ? 1
+                            : cores <= 4  ? 2
+                            : cores <= 12 ? 3
+                                          : 4;
+  if (!read_int("cpuPerformance", profile.cpu_performance) ||
+      profile.cpu_performance < 0 || profile.cpu_performance > 4) {
+    return std::nullopt;
+  }
+  return profile;
+}
+
+const std::optional<WebHardwareProfile>& GetWebHardwareProfile() {
+  static const base::NoDestructor<std::optional<WebHardwareProfile>> profile(
+      [] {
+        auto json =
+            base::Environment::Create()->GetVar("INVISIBLE_CHROMIUM_PROFILE");
+        if (!json) {
+          return std::optional<WebHardwareProfile>();
+        }
+        auto parsed = ParseWebHardwareProfile(*json);
+        CHECK(parsed)
+            << "Invalid INVISIBLE_CHROMIUM_PROFILE: expected a JSON "
+               "object with positive integer hardwareConcurrency, "
+               "deviceMemory in [8, 16, 32], and cpuPerformance in [0, 4]";
+        return parsed;
+      }());
+  return *profile;
+}
+
+}  // namespace blink
diff --git a/third_party/blink/common/hardware/web_hardware_profile_unittest.cc b/third_party/blink/common/hardware/web_hardware_profile_unittest.cc
new file mode 100644
index 0000000..eb1b10c
--- /dev/null
+++ b/third_party/blink/common/hardware/web_hardware_profile_unittest.cc
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/hardware/web_hardware_profile.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace {
+
+TEST(WebHardwareProfileTest, EmptyObjectSelectsDesktopDefaults) {
+  auto profile = ParseWebHardwareProfile("{}");
+  ASSERT_TRUE(profile);
+  EXPECT_EQ(8, profile->hardware_concurrency);
+  EXPECT_EQ(8, profile->device_memory_gb);
+  EXPECT_EQ(3, profile->cpu_performance);
+}
+
+TEST(WebHardwareProfileTest, DerivesTierFromDeclaredCores) {
+  auto profile =
+      ParseWebHardwareProfile(R"({"hardwareConcurrency":4,"deviceMemory":16})");
+  ASSERT_TRUE(profile);
+  EXPECT_EQ(4, profile->hardware_concurrency);
+  EXPECT_EQ(16, profile->device_memory_gb);
+  EXPECT_EQ(2, profile->cpu_performance);
+}
+
+TEST(WebHardwareProfileTest, ExplicitTierOverridesCoreClassification) {
+  auto profile = ParseWebHardwareProfile(
+      R"({"hardwareConcurrency":8,"deviceMemory":32,"cpuPerformance":4})");
+  ASSERT_TRUE(profile);
+  EXPECT_EQ(4, profile->cpu_performance);
+}
+
+TEST(WebHardwareProfileTest, RejectsInvalidConfiguration) {
+  for (const char* json :
+       {"", "[]", R"({"hardwareConcurrency":0})",
+        R"({"hardwareConcurrency":"8"})", R"({"deviceMemory":4})",
+        R"({"cpuPerformance":5})"}) {
+    EXPECT_FALSE(ParseWebHardwareProfile(json)) << json;
+  }
+}
+
+}  // namespace
+}  // namespace blink
