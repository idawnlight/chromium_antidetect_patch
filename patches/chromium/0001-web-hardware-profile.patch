diff --git a/third_party/blink/public/common/hardware/web_hardware_profile.h b/third_party/blink/public/common/hardware/web_hardware_profile.h
new file mode 100644
index 0000000000..1ee5acab82
--- /dev/null
+++ b/third_party/blink/public/common/hardware/web_hardware_profile.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_HARDWARE_WEB_HARDWARE_PROFILE_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_HARDWARE_WEB_HARDWARE_PROFILE_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "third_party/blink/public/common/common_export.h"
+
+namespace blink {
+
+// Web-visible Linux desktop hardware declarations, decoupled from the host
+// server's CPU/RAM/GPU resources. One immutable profile applies to the browser
+// instance and all child processes.
+struct BLINK_COMMON_EXPORT WebHardwareProfile {
+  WebHardwareProfile();
+  WebHardwareProfile(const WebHardwareProfile&);
+  WebHardwareProfile(WebHardwareProfile&&);
+  WebHardwareProfile& operator=(const WebHardwareProfile&);
+  WebHardwareProfile& operator=(WebHardwareProfile&&);
+  ~WebHardwareProfile();
+
+  int hardware_concurrency = 8;
+  int device_memory_gb = 8;
+  int cpu_performance = 3;
+  bool normalize_webgl = true;
+  std::string webgl_vendor = "Google Inc. (Intel)";
+  std::string webgl_renderer =
+      "ANGLE (Intel, Mesa Intel(R) UHD Graphics 630 (CFL GT2), OpenGL 4.6)";
+};
+
+BLINK_COMMON_EXPORT std::optional<WebHardwareProfile> ParseWebHardwareProfile(
+    std::string_view json);
+
+// Reads INVISIBLE_CHROMIUM_PROFILE once per process. When unset, returns
+// std::nullopt so stock upstream behavior is preserved.
+BLINK_COMMON_EXPORT const std::optional<WebHardwareProfile>&
+GetWebHardwareProfile();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_HARDWARE_WEB_HARDWARE_PROFILE_H_
