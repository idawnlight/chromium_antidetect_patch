diff --git a/third_party/blink/common/hardware/web_hardware_profile.cc b/third_party/blink/common/hardware/web_hardware_profile.cc
new file mode 100644
index 0000000000..03c67c9ba7
--- /dev/null
+++ b/third_party/blink/common/hardware/web_hardware_profile.cc
@@ -0,0 +1,119 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/hardware/web_hardware_profile.h"
+
+#include "base/check.h"
+#include "base/environment.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+
+namespace blink {
+
+WebHardwareProfile::WebHardwareProfile() = default;
+WebHardwareProfile::WebHardwareProfile(const WebHardwareProfile&) = default;
+WebHardwareProfile::WebHardwareProfile(WebHardwareProfile&&) = default;
+WebHardwareProfile& WebHardwareProfile::operator=(const WebHardwareProfile&) =
+    default;
+WebHardwareProfile& WebHardwareProfile::operator=(WebHardwareProfile&&) =
+    default;
+WebHardwareProfile::~WebHardwareProfile() = default;
+
+std::optional<WebHardwareProfile> ParseWebHardwareProfile(
+    std::string_view json) {
+  auto dict = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+
+  auto read_int = [&dict](std::string_view key, int& destination) {
+    const base::Value* value = dict->Find(key);
+    if (!value) {
+      return true;
+    }
+    if (!value->is_int()) {
+      return false;
+    }
+    destination = value->GetInt();
+    return true;
+  };
+
+  auto read_bool = [&dict](std::string_view key, bool& destination) {
+    const base::Value* value = dict->Find(key);
+    if (!value) {
+      return true;
+    }
+    if (!value->is_bool()) {
+      return false;
+    }
+    destination = value->GetBool();
+    return true;
+  };
+
+  auto read_nonempty_string = [&dict](std::string_view key,
+                                      std::string& destination) {
+    const base::Value* value = dict->Find(key);
+    if (!value) {
+      return true;
+    }
+    if (!value->is_string() || value->GetString().empty()) {
+      return false;
+    }
+    destination = value->GetString();
+    return true;
+  };
+
+  WebHardwareProfile profile;
+  if (!read_int("hardwareConcurrency", profile.hardware_concurrency) ||
+      !read_int("deviceMemory", profile.device_memory_gb) ||
+      profile.hardware_concurrency < 1) {
+    return std::nullopt;
+  }
+
+  if (profile.device_memory_gb != 2 && profile.device_memory_gb != 4 &&
+      profile.device_memory_gb != 8 && profile.device_memory_gb != 16 &&
+      profile.device_memory_gb != 32) {
+    return std::nullopt;
+  }
+
+  const int cores = profile.hardware_concurrency;
+  profile.cpu_performance = cores <= 2    ? 1
+                            : cores <= 4  ? 2
+                            : cores <= 12 ? 3
+                                          : 4;
+  if (!read_int("cpuPerformance", profile.cpu_performance) ||
+      profile.cpu_performance < 0 || profile.cpu_performance > 4) {
+    return std::nullopt;
+  }
+
+  if (!read_bool("normalizeWebgl", profile.normalize_webgl) ||
+      !read_nonempty_string("webglVendor", profile.webgl_vendor) ||
+      !read_nonempty_string("webglRenderer", profile.webgl_renderer)) {
+    return std::nullopt;
+  }
+
+  return profile;
+}
+
+const std::optional<WebHardwareProfile>& GetWebHardwareProfile() {
+  static const base::NoDestructor<std::optional<WebHardwareProfile>> profile(
+      []() -> std::optional<WebHardwareProfile> {
+        auto json =
+            base::Environment::Create()->GetVar("INVISIBLE_CHROMIUM_PROFILE");
+        if (!json) {
+          return std::nullopt;
+        }
+        auto parsed = ParseWebHardwareProfile(*json);
+        CHECK(parsed)
+            << "Invalid INVISIBLE_CHROMIUM_PROFILE: expected a JSON object "
+               "with positive integer hardwareConcurrency, deviceMemory in "
+               "[2, 4, 8, 16, 32], cpuPerformance in [0, 4], optional bool "
+               "normalizeWebgl, and non-empty webglVendor/webglRenderer";
+        return parsed;
+      }());
+  return *profile;
+}
+
+}  // namespace blink
diff --git a/third_party/blink/common/hardware/web_hardware_profile_unittest.cc b/third_party/blink/common/hardware/web_hardware_profile_unittest.cc
new file mode 100644
index 0000000000..2df82c107c
--- /dev/null
+++ b/third_party/blink/common/hardware/web_hardware_profile_unittest.cc
@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/hardware/web_hardware_profile.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace {
+
+TEST(WebHardwareProfileTest, EmptyObjectSelectsLinuxDesktopDefaults) {
+  auto profile = ParseWebHardwareProfile("{}");
+  ASSERT_TRUE(profile);
+  EXPECT_EQ(8, profile->hardware_concurrency);
+  EXPECT_EQ(8, profile->device_memory_gb);
+  EXPECT_EQ(3, profile->cpu_performance);
+  EXPECT_TRUE(profile->normalize_webgl);
+  EXPECT_EQ("Google Inc. (Intel)", profile->webgl_vendor);
+  EXPECT_EQ("ANGLE (Intel, Mesa Intel(R) UHD Graphics 630 (CFL GT2), OpenGL 4.6)",
+            profile->webgl_renderer);
+}
+
+TEST(WebHardwareProfileTest, SupportsAllDesktopMemoryTiersAndDerivesCpuTier) {
+  for (int ram_gb : {2, 4, 8, 16, 32}) {
+    auto profile = ParseWebHardwareProfile(
+        "{\"hardwareConcurrency\":4,\"deviceMemory\":" +
+        std::to_string(ram_gb) + "}");
+    ASSERT_TRUE(profile) << ram_gb;
+    EXPECT_EQ(4, profile->hardware_concurrency);
+    EXPECT_EQ(ram_gb, profile->device_memory_gb);
+    EXPECT_EQ(2, profile->cpu_performance);
+  }
+}
+
+TEST(WebHardwareProfileTest, ExplicitOverridesApplyCleanly) {
+  auto profile = ParseWebHardwareProfile(
+      R"json({"hardwareConcurrency":12,"deviceMemory":16,"cpuPerformance":4,)json"
+      R"json("normalizeWebgl":false,"webglVendor":"Google Inc. (AMD)",)json"
+      R"json("webglRenderer":"ANGLE (AMD, AMD Radeon Graphics, OpenGL 4.6)"})json");
+  ASSERT_TRUE(profile);
+  EXPECT_EQ(12, profile->hardware_concurrency);
+  EXPECT_EQ(16, profile->device_memory_gb);
+  EXPECT_EQ(4, profile->cpu_performance);
+  EXPECT_FALSE(profile->normalize_webgl);
+  EXPECT_EQ("Google Inc. (AMD)", profile->webgl_vendor);
+  EXPECT_EQ("ANGLE (AMD, AMD Radeon Graphics, OpenGL 4.6)",
+            profile->webgl_renderer);
+}
+
+TEST(WebHardwareProfileTest, RejectsInvalidConfiguration) {
+  for (const char* json :
+       {"", "[]", R"({"hardwareConcurrency":0})",
+        R"({"hardwareConcurrency":"8"})", R"({"deviceMemory":6})",
+        R"({"cpuPerformance":5})", R"({"webglVendor":""})",
+        R"({"webglRenderer":""})", R"({"normalizeWebgl":"yes"})"}) {
+    EXPECT_FALSE(ParseWebHardwareProfile(json)) << json;
+  }
+}
+
+}  // namespace
+}  // namespace blink
